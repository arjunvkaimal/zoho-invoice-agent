# Zoho Books API Credentials (Self Client / OAuth)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_organization_id_here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/books/v3

# Optional Zoho settings
# ZOHO_GST_ENABLED=true
# GST_PERCENT=18

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# WhatsApp (Baileys) Listener Configuration
ALLOWED_GROUP_JID=120363000000000000@g.us
